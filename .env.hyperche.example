POSTGRES_DB=hyperche
POSTGRES_USER=hyperche
POSTGRES_PASSWORD=replace_with_a_long_random_password
JWT_SECRET=replace_with_a_long_random_jwt_secret
APP_SECRET_KEY=replace_with_a_long_random_app_secret
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
CORS_ORIGINS=https://cupzhouth.top
COOKIE_SECURE=true
TRIAL_DOC_LIMIT=3
TRIAL_LLM_CALL_LIMIT=50
TRIAL_EMBEDDING_CALL_LIMIT=200
# Set both fields to bootstrap an administrator; no default account is created.
HYPERCHE_ADMIN_EMAIL=admin@cupzhouth.top
HYPERCHE_ADMIN_PASSWORD=replace_with_a_long_random_admin_password
HYPERCHE_ADMIN_NAME=HyperChE Admin
# The selected database must be built or mounted separately.
HYPERCHE_PUBLIC_DEMO_DATABASE=case1
# Frozen final cache is supplied privately and mounted read-only.
HYPERCHE_FINAL_CACHE_HOST_DIR=/opt/hyperche/shared/final_cache
HYPERCHE_FINAL_CACHE_DATABASE=case1
# The public alias stays case1; its cache_version in responses is final_v1.
HYPERCHE_PUBLIC_IP_PER_MINUTE=2
HYPERCHE_PUBLIC_IP_PER_DAY=20
HYPERCHE_PUBLIC_GLOBAL_PER_DAY=100
HYPERCHE_PUBLIC_IP_CONCURRENCY=1
HYPERCHE_PUBLIC_GLOBAL_CONCURRENCY=2
# Only the host / container reverse-proxy chain supplies client IP headers.
HYPERCHE_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
