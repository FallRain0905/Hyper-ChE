# Public HTTP port exposed by the nginx container.
WEB_PORT=5000

# Generate unique random values before production deployment.
JWT_SECRET=replace-with-a-long-random-secret
APP_SECRET_KEY=replace-with-a-different-long-random-secret

# Optional overrides. The defaults match the current administrator account.
# HYPERCHE_ADMIN_EMAIL=cupzhouth@admin.com
# HYPERCHE_ADMIN_PASSWORD=change-this-before-public-launch
